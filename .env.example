# ==========================================
# CAMPUSFLOW ROOT ENVIRONMENT CONFIGURATION
# ==========================================

# Server Environment Variables (copied to server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow
