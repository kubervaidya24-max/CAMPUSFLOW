# ==============================================================================
# CampusFlow — Root Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure respective server/.env and client/.env files.
# NEVER commit actual secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost

# MongoDB Connection URI (Local Docker instance or MongoDB Atlas Cluster)
MONGODB_URI=mongodb://mongo:27017/campusflow

# CORS Origin Allowed
CORS_ORIGIN=http://localhost

# JWT Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_64_character_access_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_character_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Signed Cookie Secret (Generate with: openssl rand -base64 32)
COOKIE_SECRET=replace_with_a_secure_random_64_character_cookie_secret
